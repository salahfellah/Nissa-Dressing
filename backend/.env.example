# ————— Base de données —————
# Correspond au service `postgres` de docker-compose.yml (port hôte 5433).
DATABASE_URL="postgresql://nissa:nissa_dev_password@localhost:5435/nissa_dressing?schema=public"

# ————— Serveur —————
PORT=4000
NODE_ENV=development
# Origine autorisée en CORS (le front Next).
WEB_ORIGIN="http://localhost:3000"
# Base publique de l'API, utilisée pour construire les URL de fichiers.
API_PUBLIC_URL="http://localhost:4000"

# ————— Authentification —————
# Ces valeurs conviennent au développement uniquement. Avec NODE_ENV=production,
# l'API REFUSE de démarrer tant qu'elles n'ont pas été remplacées : mieux vaut
# un démarrage qui échoue qu'un site en ligne avec des jetons forgeables.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="dev-access-secret-a-remplacer-en-production"
JWT_REFRESH_SECRET="dev-refresh-secret-a-remplacer-en-production"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# En production, les cookies sont Secure par défaut : cette variable ne sert
# qu'à les désactiver volontairement, ce qui est refusé au démarrage.
COOKIE_SECURE=false

# ————— Compte administratrice (créé par `npm run db:seed`) —————
ADMIN_EMAIL="admin@nissa-dressing.fr"
ADMIN_PASSWORD="Admin1234"
ADMIN_PSEUDO="administratrice"

# ————— Stripe (CDC §4.2) —————
# Laisser vide : l'API bascule alors en mode simulé et tout le parcours
# paiement / séquestre / reversement reste jouable en local sans compte Stripe.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_BOOST_PRICE_ID=""

# ————— E-mails —————
# Service `mailpit` de docker-compose.yml : tous les e-mails sont capturés et
# consultables sur http://localhost:8025 — rien ne part vers l'extérieur.
# Laisse SMTP_HOST vide pour écrire les e-mails dans backend/var/mail/ à la place.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Nissa Dressing <ne-pas-repondre@nissa-dressing.fr>"

# ————— Fichiers —————
UPLOAD_DIR="var/uploads"
MAX_PHOTO_SIZE_MB=8
MAX_AUDIO_SIZE_MB=15

# ————— Commandes impayées —————
# Une commande créée mais jamais payée réserve son article. Passé ce délai, elle
# est annulée et l'article revient au catalogue. Le rythme de vérification est
# réglable (format cron à 6 champs) — pratique pour tester sans attendre.
# PENDING_PAYMENT_TTL_MINUTES=30
# PENDING_ORDER_CLEANUP_CRON="0 */10 * * * *"

# ————— Limites de débit —————
# Défauts adaptés à la production. Les relever uniquement pour exécuter la suite
# de tests de bout en bout ou un test de charge (voir e2e/README.md).
# THROTTLE_LIMIT=120
# AUTH_THROTTLE_LIMIT=10
# SIGNUP_THROTTLE_LIMIT=5
# CONTACT_THROTTLE_LIMIT=5
